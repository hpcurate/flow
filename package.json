{
  "name": "flow",
  "version": "1.5.0",
  "description": "FLOW — Ambiance / Focus player",
  "main": "main.js",
  "author": "Hugo",
  "scripts": {
    "start": "electron .",
    "test:ui": "electron test/visual.cjs",
    "icon": "node mark.js",
    "pack": "electron-packager . FLOW --platform=win32 --arch=x64 --icon=build/icon.ico --out=dist --overwrite --prune=true --ignore=\"(^/dist|^/test|^/\\.git|^/gui-check\\.js|^/shot-.*\\.png|^/SESSION-LOG\\.md)\"",
    "dist": "electron-builder --win --x64",
    "perf": "electron test/perf.cjs"
  },
  "build": {
    "appId": "com.hugo.flow",
    "productName": "FLOW",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "flow.css",
      "viz.js",
      "app.js",
      "mark.js",
      "smtc.ps1",
      "pill.html",
      "pill.css",
      "pill.js",
      "pill-main.js",
      "pill-preload.js",
      "pill.ps1",
      "timers-main.js",
      "timers-preload.js",
      "timers-ui.js",
      "timers-pop.js",
      "timers.html",
      "timers.css",
      "ring.html",
      "ring.css",
      "ring.js",
      "build/icon.ico",
      "fonts/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "FLOW-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "FLOW-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
